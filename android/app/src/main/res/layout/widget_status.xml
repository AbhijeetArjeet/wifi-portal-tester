<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widgetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📶 WiFi Portal Connector"
            android:textColor="#8fa3c9"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetDnsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DNS: Off"
            android:textColor="#6ee7b7"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/widgetSpeedValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#3b82f6"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Mbps"
            android:layout_marginBottom="4dp"
            android:layout_gravity="bottom"
            android:textColor="#8fa3c9"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widgetPingValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Ping: -- ms"
            android:textColor="#c7d2e6"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetUpdatedAt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Updated: never — open the app"
        android:textColor="#5b6b8c"
        android:textSize="9.5sp" />

</LinearLayout>
